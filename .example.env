### SERVER URL
SERVER_URL="http://...:8001"
SERVER_API_KEY="..."

### MIDDLEWARE (optional fallback when the universal API key carries no base URL)
### Used by /api/chat, /api/tts, /api/stt and /api/imagegen
MIDDLEWARE_URL="http://127.0.0.1:8001"

### MAILBOX SYNC (/api/mailsync)
### The mailbox credentials come from the browser with every request; the
### server stores nothing. These knobs only bound what it may connect to.
### Max size of one uncompressed snapshot (default 200):
# MAILSYNC_MAX_SNAPSHOT_MB="200"
### Gzipped bytes per mail - keep below the provider's attachment limit
### (base64 adds about a third). Default 10:
# MAILSYNC_CHUNK_MB="10"
### Additional allowed ports besides 25/143/465/587/993/2525:
# MAILSYNC_EXTRA_PORTS="3143,3025"
### Allow loopback/private addresses and any port. Needed for a mail server
### on the same host, but turns a public deployment into a network prober:
# MAILSYNC_ALLOW_INSECURE_HOSTS="1"

### SPEECH TO TEXT
GROQ_API_KEY="gsk_..."
GROQ_API_MODEL="whisper-large-v3"

### LARGE LANGUAGE MODELS
API_URL="https://.../v1/chat/completions"
API_KEY="api-key"
API_MODEL="gpt-4o"